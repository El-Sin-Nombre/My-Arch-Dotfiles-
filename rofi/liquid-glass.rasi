
* {
    font: "JetBrainsMono Nerd Font 12";
    text-color: #292929;
    background-color: transparent;
}

window {
    width: 600px;
    border: 1px;
    border-color: #FFF1B566;
    border-radius: 24px;
    background-color: #FFF1B51f;
    padding: 18px;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: #FFF1B538;
    border: 1px;
    border-color: #FFF1B580;
    border-radius: 16px;
    padding: 12px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #555555;
}

entry {
    placeholder: "Qué tengo que hacer";
    placeholder-color: #777777;
}

listview {
    columns: 1;
    lines: 6;
    fixed-height: true;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    border-radius: 12px;
    spacing: 10px;
}

element-icon {
    enabled: false;
}

element-text {
    text-color: #292929;
    background-color: transparent;
    vertical-align: 0.5;
}

element selected {
    background-color: #FFF1B570;
    border: 1px;
    border-color: #FFF1B5a0;
}

element-text selected {
    text-color: #111111;
}

