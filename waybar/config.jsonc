
{
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 8,

  "modules-left": [
    "custom/arch",	  
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "active-only": false,
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 6
    }
  },

  "clock": {
    "format": "{:%d-%m-%y || %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A}",
    "interval": 1
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "MUTED",
    "tooltip": true,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "network": {
    "format-wifi": "󰖩 {essid} {signalStrength}%",
    "format-ethernet": "LAN",
    "format-linked": "Connecting…",
    "format-disconnected": "Offline",
    "tooltip": true,
    "interval": 5
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰁹 {capacity}%",
    "format-charging": "CHG {capacity}%",
    "format-plugged": "AC {capacity}%",
    "format-full": "FULL {capacity}%",
    "tooltip": true,
    "interval": 10
  },

  "custom/arch": {
    "format": "󰣇",
    "tooltip": false
 }
}
